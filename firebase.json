{
  "hosting": {
    "site": "meritcyc-landing",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": [
    {
      "source": "seo-bot",
      "codebase": "seo-bot",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "src",
        ".git",
        "*.log",
        ".env.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
